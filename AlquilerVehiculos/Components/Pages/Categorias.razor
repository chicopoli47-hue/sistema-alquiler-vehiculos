@rendermode InteractiveServer

@page "/categorias"

@using System.ComponentModel.DataAnnotations
@using Microsoft.EntityFrameworkCore
@using Microsoft.Data.SqlClient
@using AlquilerVehiculos.Data
@using AlquilerVehiculos.Models

@inject IDbContextFactory<AlquilerDbContext> DbFactory

<PageTitle>Categorías</PageTitle>

<h1>Gestión de categorías</h1>

<p>Administra las categorías disponibles para el alquiler de vehículos.</p>

<div class="mb-3">
    <button class="btn btn-primary"
            @onclick="NuevaCategoria"
            disabled="@guardando">
        Nueva categoría
    </button>
</div>

@if (!string.IsNullOrWhiteSpace(mensaje))
{
    <div class="alert alert-success" role="alert">
        @mensaje
    </div>
}

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger" role="alert">
        @error
    </div>
}

@if (cargando)
{
    <p>Cargando categorías...</p>
}
else
{
    @if (mostrandoFormulario)
    {
        <div class="card mb-4">
            <div class="card-body">
                <h2 class="h5">
                    @(esEdicion ? "Editar categoría" : "Crear categoría")
                </h2>

                <EditForm Model="@formulario"
                          OnValidSubmit="@GuardarCategoria">
                    <DataAnnotationsValidator />

                    <div class="mb-3">
                        <label for="nombre" class="form-label">
                            Nombre
                        </label>

                        <InputText id="nombre"
                                   class="form-control"
                                   @bind-Value="formulario.Nombre" />

                        <ValidationMessage For="@(() => formulario.Nombre)" />
                    </div>

                    <div class="mb-3">
                        <label for="descripcion" class="form-label">
                            Descripción
                        </label>

                        <InputTextArea id="descripcion"
                                       class="form-control"
                                       @bind-Value="formulario.Descripcion" maxlength="200" />

                        <small class="text-muted">Máximo 200 caracteres.</small>
                                       
                        <ValidationMessage For="@(() => formulario.Descripcion)" />
                    </div>

                    <button type="submit"
                            class="btn btn-success me-2"
                            disabled="@guardando">
                        @(guardando ? "Guardando..." : "Guardar")
                    </button>

                    <button type="button"
                            class="btn btn-secondary"
                            @onclick="CancelarFormulario"
                            disabled="@guardando">
                        Cancelar
                    </button>
                </EditForm>
            </div>
        </div>
    }

    @if (categorias.Count == 0)
    {
        <div class="alert alert-info">
            No hay categorías registradas.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover tabla-categorias">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nombre</th>
                        <th>Descripción</th>
                        <th>Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var categoria in categorias)
                    {
                        <tr @key="categoria.IdCategoria">
                            <td>@categoria.IdCategoria</td>
                            <td>@categoria.Nombre</td>
                            <td class="descripcion-categoria">@(categoria.Descripcion ?? "Sin descripción")</td>
                            <td>
                                <button class="btn btn-sm btn-warning me-1"
                                        @onclick="() => EditarCategoria(categoria.IdCategoria)"
                                        disabled="@guardando">
                                    Editar
                                </button>

                                <button class="btn btn-sm btn-danger"
                                        @onclick="() => EliminarCategoria(categoria.IdCategoria)"
                                        disabled="@guardando">
                                    Eliminar
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

<style>
    .tabla-categorias {
        table-layout: fixed;
        width: 100%;
    }

    .tabla-categorias th,
    .tabla-categorias td {
        overflow-wrap: anywhere;
        vertical-align: middle;
    }

    .tabla-categorias th:nth-child(1) { width: 8%; }
    .tabla-categorias th:nth-child(2) { width: 20%; }
    .tabla-categorias th:nth-child(3) { width: 47%; }
    .tabla-categorias th:nth-child(4) { width: 25%; }

    .tabla-categorias .descripcion-categoria {
        overflow-wrap: anywhere;
    }

    .tabla-categorias td:last-child {
        white-space: nowrap;
    }
</style>

@code {
    private List<Categoria> categorias = new();

    private FormularioCategoria formulario = new();

    private bool cargando = true;
    private bool guardando;
    private bool mostrandoFormulario;
    private bool esEdicion;

    private int? idCategoriaEdicion;

    private string? mensaje;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        await CargarCategorias();
    }

    private async Task CargarCategorias()
    {
        cargando = true;
        error = null;

        try
        {
            await using var db =
                await DbFactory.CreateDbContextAsync();

            categorias = await db.Categoria
                .AsNoTracking()
                .OrderBy(c => c.Nombre)
                .ToListAsync();
        }
        catch (Exception)
        {
            error = "No se pudieron cargar las categorías. " +
                    "Verifica la conexión con la base de datos.";
        }
        finally
        {
            cargando = false;
        }
    }

    private void NuevaCategoria()
    {
        error = null;
        mensaje = null;

        formulario = new FormularioCategoria();
        idCategoriaEdicion = null;
        esEdicion = false;
        mostrandoFormulario = true;
    }

    private async Task EditarCategoria(int id)
    {
        error = null;
        mensaje = null;

        try
        {
            await using var db =
                await DbFactory.CreateDbContextAsync();

            var categoria = await db.Categoria
                .AsNoTracking()
                .FirstOrDefaultAsync(c => c.IdCategoria == id);

            if (categoria is null)
            {
                error = "La categoría ya no existe.";
                await CargarCategorias();
                return;
            }

            formulario = new FormularioCategoria
            {
                Nombre = categoria.Nombre,
                Descripcion = categoria.Descripcion
            };

            idCategoriaEdicion = id;
            esEdicion = true;
            mostrandoFormulario = true;
        }
        catch (Exception)
        {
            error = "No se pudo cargar la categoría para editar.";
        }
    }

    private async Task GuardarCategoria()
    {
        if (guardando)
            return;

        guardando = true;
        error = null;
        mensaje = null;

        try
        {
            await using var db =
                await DbFactory.CreateDbContextAsync();

            if (esEdicion && idCategoriaEdicion.HasValue)
            {
                var categoria = await db.Categoria
                    .FirstOrDefaultAsync(
                        c => c.IdCategoria == idCategoriaEdicion.Value);

                if (categoria is null)
                {
                    error = "La categoría que intentas editar ya no existe.";
                    return;
                }

                categoria.Nombre = formulario.Nombre.Trim();
                categoria.Descripcion =
                    LimpiarDescripcion(formulario.Descripcion);

                await db.SaveChangesAsync();

                mensaje = "Categoría actualizada correctamente.";
            }
            else
            {
                var categoria = new Categoria
                {
                    Nombre = formulario.Nombre.Trim(),
                    Descripcion =
                        LimpiarDescripcion(formulario.Descripcion)
                };

                db.Categoria.Add(categoria);
                await db.SaveChangesAsync();

                mensaje = "Categoría creada correctamente.";
            }

            mostrandoFormulario = false;
            await CargarCategorias();
        }
        catch (DbUpdateException)
        {
            error = "No se pudo guardar la categoría. " +
                    "Comprueba las restricciones y los datos de la base de datos.";
        }
        catch (Exception)
        {
            error = "Ocurrió un error al guardar la categoría.";
        }
        finally
        {
            guardando = false;
        }
    }

    private async Task EliminarCategoria(int id)
    {
        error = null;
        mensaje = null;

        bool confirmar = await JSConfirmar(
            "¿Estás seguro de que deseas eliminar esta categoría?");

        if (!confirmar)
            return;

        if (guardando)
            return;

        guardando = true;

        try
        {
            await using var db =
                await DbFactory.CreateDbContextAsync();

            var categoria = await db.Categoria
                .FirstOrDefaultAsync(c => c.IdCategoria == id);

            if (categoria is null)
            {
                error = "La categoría ya no existe.";
                await CargarCategorias();
                return;
            }

            db.Categoria.Remove(categoria);
            await db.SaveChangesAsync();

            mensaje = "Categoría eliminada correctamente.";

            if (idCategoriaEdicion == id)
                CancelarFormulario();

            await CargarCategorias();
        }
        catch (DbUpdateException)
        {
            error = "No se pudo eliminar la categoría. " +
                    "Es posible que tenga vehículos u otros registros asociados.";
        }
        catch (Exception)
        {
            error = "Ocurrió un error al eliminar la categoría.";
        }
        finally
        {
            guardando = false;
        }
    }

    private void CancelarFormulario()
    {
        mostrandoFormulario = false;
        formulario = new FormularioCategoria();
        idCategoriaEdicion = null;
        esEdicion = false;
    }

    private static string? LimpiarDescripcion(string? descripcion)
    {
        return string.IsNullOrWhiteSpace(descripcion)
            ? null
            : descripcion.Trim();
    }

    private async Task<bool> JSConfirmar(string texto)
    {
        return await JS.InvokeAsync<bool>("confirm", texto);
    }

    [Inject]
    private Microsoft.JSInterop.IJSRuntime JS { get; set; } = default!;

    private sealed class FormularioCategoria
    {
        [Required(ErrorMessage = "El nombre es obligatorio.")]
        public string Nombre { get; set; } = string.Empty;

        [StringLength(200)]
        public string? Descripcion { get; set; }
    }
}

