
@page "/"

<PageTitle>Inicio | Alquiler de Vehículos</PageTitle>

<div class="container-fluid px-3 px-lg-4 py-4">

    @* Encabezado principal *@
    <div class="p-4 p-lg-5 mb-4 rounded-4 text-white shadow"
         style="background: linear-gradient(120deg, #172554 0%, #1d4ed8 65%, #2563eb 100%);">

        <div class="row align-items-center g-4">
            <div class="col-lg-8">
                <span class="badge rounded-pill bg-light text-primary mb-3 px-3 py-2">
                    <i class="bi bi-speedometer2 me-1"></i>
                    PANEL PRINCIPAL
                </span>

                <h1 class="display-5 fw-bold mb-3">
                    Sistema de Alquiler de Vehículos
                </h1>

                <p class="lead mb-4" style="max-width: 650px;">
                    Administra clientes, vehículos, reservas y alquileres
                    desde un solo lugar, de manera sencilla y organizada.
                </p>

                <div class="d-flex flex-wrap gap-2">
                    <a href="/reservas" class="btn btn-light btn-lg fw-semibold">
                        <i class="bi bi-calendar-check me-2"></i>
                        Gestionar reservas
                    </a>

                    <a href="/clientes"
                       class="btn btn-outline-light btn-lg">
                        <i class="bi bi-people me-2"></i>
                        Ver clientes
                    </a>
                </div>
            </div>

            <div class="col-lg-4 text-center d-none d-lg-block">
                <i class="bi bi-car-front-fill"
                   style="font-size: 150px; opacity: .9;"></i>
            </div>
        </div>
    </div>

    @* Accesos a los módulos *@
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <div>
            <h2 class="h4 fw-bold mb-1">Acceso rápido</h2>
            <p class="text-secondary mb-0">
                Selecciona el módulo que deseas utilizar.
            </p>
        </div>
    </div>

    <div class="row g-3 mb-4">

        <div class="col-12 col-sm-6 col-xl-4">
            <a href="/clientes" class="text-decoration-none">
                <div class="card h-100 border-0 shadow-sm rounded-4 module-card">
                    <div class="card-body p-4">
                        <div class="rounded-3 bg-primary-subtle text-primary d-flex align-items-center justify-content-center mb-3"
                             style="width: 55px; height: 55px;">
                            <i class="bi bi-people-fill fs-3"></i>
                        </div>
                        <h3 class="h5 fw-bold text-dark">Clientes</h3>
                        <p class="text-secondary mb-3">
                            Registra, consulta y actualiza la información de los clientes.
                        </p>
                        <span class="text-primary fw-semibold">
                            Abrir módulo <i class="bi bi-arrow-right ms-1"></i>
                        </span>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-12 col-sm-6 col-xl-4">
            <a href="/vehiculos" class="text-decoration-none">
                <div class="card h-100 border-0 shadow-sm rounded-4 module-card">
                    <div class="card-body p-4">
                        <div class="rounded-3 bg-success-subtle text-success d-flex align-items-center justify-content-center mb-3"
                             style="width: 55px; height: 55px;">
                            <i class="bi bi-car-front-fill fs-3"></i>
                        </div>
                        <h3 class="h5 fw-bold text-dark">Vehículos</h3>
                        <p class="text-secondary mb-3">
                            Consulta y administra los vehículos y sus estados.
                        </p>
                        <span class="text-success fw-semibold">
                            Abrir módulo <i class="bi bi-arrow-right ms-1"></i>
                        </span>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-12 col-sm-6 col-xl-4">
            <a href="/reservas" class="text-decoration-none">
                <div class="card h-100 border-0 shadow-sm rounded-4 module-card">
                    <div class="card-body p-4">
                        <div class="rounded-3 bg-warning-subtle text-warning-emphasis d-flex align-items-center justify-content-center mb-3"
                             style="width: 55px; height: 55px;">
                            <i class="bi bi-calendar-check-fill fs-3"></i>
                        </div>
                        <h3 class="h5 fw-bold text-dark">Reservas</h3>
                        <p class="text-secondary mb-3">
                            Gestiona las reservas y organiza los períodos de alquiler.
                        </p>
                        <span class="text-warning-emphasis fw-semibold">
                            Abrir módulo <i class="bi bi-arrow-right ms-1"></i>
                        </span>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-12 col-sm-6 col-xl-4">
            <a href="/categorias" class="text-decoration-none">
                <div class="card h-100 border-0 shadow-sm rounded-4 module-card">
                    <div class="card-body p-4">
                        <div class="rounded-3 bg-info-subtle text-info-emphasis d-flex align-items-center justify-content-center mb-3"
                             style="width: 55px; height: 55px;">
                            <i class="bi bi-grid-fill fs-3"></i>
                        </div>
                        <h3 class="h5 fw-bold text-dark">Categorías</h3>
                        <p class="text-secondary mb-3">
                            Organiza los vehículos por tipo o categoría.
                        </p>
                        <span class="text-info-emphasis fw-semibold">
                            Abrir módulo <i class="bi bi-arrow-right ms-1"></i>
                        </span>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-12 col-sm-6 col-xl-4">
            <a href="/contratos" class="text-decoration-none">
                <div class="card h-100 border-0 shadow-sm rounded-4 module-card">
                    <div class="card-body p-4">
                        <div class="rounded-3 bg-danger-subtle text-danger d-flex align-items-center justify-content-center mb-3"
                             style="width: 55px; height: 55px;">
                            <i class="bi bi-file-earmark-text-fill fs-3"></i>
                        </div>
                        <h3 class="h5 fw-bold text-dark">Contratos</h3>
                        <p class="text-secondary mb-3">
                            Accede a la gestión de los contratos de alquiler.
                        </p>
                        <span class="text-danger fw-semibold">
                            Abrir módulo <i class="bi bi-arrow-right ms-1"></i>
                        </span>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-12 col-sm-6 col-xl-4">
            <a href="/reportes" class="text-decoration-none">
                <div class="card h-100 border-0 shadow-sm rounded-4 module-card">
                    <div class="card-body p-4">
                        <div class="rounded-3 bg-secondary-subtle text-secondary d-flex align-items-center justify-content-center mb-3"
                             style="width: 55px; height: 55px;">
                            <i class="bi bi-bar-chart-fill fs-3"></i>
                        </div>
                        <h3 class="h5 fw-bold text-dark">Reportes</h3>
                        <p class="text-secondary mb-3">
                            Consulta información resumida de las operaciones.
                        </p>
                        <span class="text-secondary fw-semibold">
                            Abrir módulo <i class="bi bi-arrow-right ms-1"></i>
                        </span>
                    </div>
                </div>
            </a>
        </div>

    </div>

    @* Información complementaria *@
    <div class="row g-3">
        <div class="col-12 col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <h2 class="h5 fw-bold mb-3">
                        <i class="bi bi-info-circle text-primary me-2"></i>
                        Sobre el sistema
                    </h2>
                    <p class="text-secondary mb-0">
                        Esta aplicación centraliza la información necesaria para
                        administrar el alquiler de vehículos. Su propósito es
                        facilitar el control de clientes, flota, reservas y
                        operaciones relacionadas.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <h2 class="h5 fw-bold mb-3">
                        <i class="bi bi-shield-check text-success me-2"></i>
                        Control y organización
                    </h2>

                    <div class="d-flex align-items-start gap-3 mb-3">
                        <i class="bi bi-check-circle-fill text-success mt-1"></i>
                        <div>
                            <div class="fw-semibold">Información centralizada</div>
                            <small class="text-secondary">
                                Datos organizados en una base de datos común.
                            </small>
                        </div>
                    </div>

                    <div class="d-flex align-items-start gap-3">
                        <i class="bi bi-check-circle-fill text-success mt-1"></i>
                        <div>
                            <div class="fw-semibold">Gestión de operaciones</div>
                            <small class="text-secondary">
                                Acceso a los módulos disponibles del sistema.
                            </small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <footer class="text-center text-secondary small mt-4 pt-3 border-top">
        Sistema de Alquiler de Vehículos
    </footer>

</div>

<style>
    .module-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .module-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 .75rem 1.5rem rgba(0, 0, 0, .10) !important;
    }
</style>
