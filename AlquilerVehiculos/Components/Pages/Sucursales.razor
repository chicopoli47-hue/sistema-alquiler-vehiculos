
@page "/sucursales"
@rendermode InteractiveServer

@using System.ComponentModel.DataAnnotations
@using Microsoft.EntityFrameworkCore
@using AlquilerVehiculos.Data
@using AlquilerVehiculos.Models

@inject IDbContextFactory<AlquilerDbContext> DbFactory

<PageTitle>Sucursales</PageTitle>

<h1>Gestión de sucursales</h1>
<p>Administra las sucursales del sistema de alquiler de vehículos.</p>

<div class="mb-3">
    <button class="btn btn-primary" @onclick="NuevaSucursal"
            disabled="@guardando">
        Nueva sucursal
    </button>
</div>

@if (!string.IsNullOrWhiteSpace(mensaje))
{
    <div class="alert alert-success">@mensaje</div>
}

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger">@error</div>
}

@if (cargando)
{
    <p>Cargando sucursales...</p>
}
else
{
    @if (mostrandoFormulario)
    {
        <div class="card mb-4">
            <div class="card-body">
                <h2 class="h5">@(esEdicion ? "Editar sucursal" : "Crear sucursal")</h2>

                <EditForm Model="@formulario" OnValidSubmit="@GuardarSucursal">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="mb-3">
                        <label for="nombre" class="form-label">Nombre *</label>
                        <InputText id="nombre" class="form-control"
                                   @bind-Value="formulario.Nombre" maxlength="80" />
                        <small class="text-muted">Máximo 80 caracteres.</small>
                        <ValidationMessage For="@(() => formulario.Nombre)" />
                    </div>

                    <div class="mb-3">
                        <label for="direccion" class="form-label">Dirección</label>
                        <InputTextArea id="direccion" class="form-control"
                                       @bind-Value="formulario.Direccion"
                                       maxlength="200" />
                        <small class="text-muted">Máximo 200 caracteres.</small>
                        <ValidationMessage For="@(() => formulario.Direccion)" />
                    </div>

                    <div class="mb-3">
                        <label for="telefono" class="form-label">Teléfono</label>
                        <InputText id="telefono" class="form-control"
                                   @bind-Value="formulario.Telefono" maxlength="20" />
                        <small class="text-muted">Máximo 20 caracteres.</small>
                        <ValidationMessage For="@(() => formulario.Telefono)" />
                    </div>

                    <div class="form-check mb-3">
                        <InputCheckbox id="activa" class="form-check-input"
                                       @bind-Value="formulario.Activa" />
                        <label for="activa" class="form-check-label">Sucursal activa</label>
                    </div>

                    <button type="submit" class="btn btn-success me-2"
                            disabled="@guardando">
                        @(guardando ? "Guardando..." : "Guardar")
                    </button>

                    <button type="button" class="btn btn-secondary"
                            @onclick="CancelarFormulario" disabled="@guardando">
                        Cancelar
                    </button>
                </EditForm>
            </div>
        </div>
    }

    @if (sucursales.Count == 0)
    {
        <div class="alert alert-info">No hay sucursales registradas.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nombre</th>
                        <th>Dirección</th>
                        <th>Teléfono</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var sucursal in sucursales)
                    {
                        <tr @key="sucursal.IdSucursal">
                            <td>@sucursal.IdSucursal</td>
                            <td>@sucursal.Nombre</td>
                            <td>@(sucursal.Direccion ?? "—")</td>
                            <td>@(sucursal.Telefono ?? "—")</td>
                            <td>@(sucursal.Activa ? "Activa" : "Inactiva")</td>
                            <td>
    <div class="d-flex flex-nowrap gap-2">
        <button class="btn btn-sm btn-warning flex-shrink-0"
                @onclick="() => EditarSucursal(sucursal.IdSucursal)"
                disabled="@guardando">
            Editar
        </button>

        <button class="btn btn-sm btn-danger flex-shrink-0"
                @onclick="() => CambiarEstado(sucursal.IdSucursal)"
                disabled="@guardando">
            @(sucursal.Activa ? "Desactivar" : "Activar")
        </button>
    </div>
</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    private List<Sucursal> sucursales = new();
    private FormularioSucursal formulario = new();

    private bool cargando = true;
    private bool guardando;
    private bool mostrandoFormulario;
    private bool esEdicion;
    private int? idSucursalEdicion;

    private string? mensaje;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        await CargarSucursales();
    }

    private async Task CargarSucursales()
    {
        cargando = true;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            sucursales = await db.Sucursal
                .AsNoTracking()
                .OrderBy(s => s.Nombre)
                .ToListAsync();
        }
        catch (Exception)
        {
            error = "No se pudieron cargar las sucursales. Verifica la conexión con la base de datos.";
        }
        finally
        {
            cargando = false;
        }
    }

    private void NuevaSucursal()
    {
        error = null;
        mensaje = null;
        formulario = new FormularioSucursal { Activa = true };
        idSucursalEdicion = null;
        esEdicion = false;
        mostrandoFormulario = true;
    }

    private async Task EditarSucursal(int id)
    {
        error = null;
        mensaje = null;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            var sucursal = await db.Sucursal
                .AsNoTracking()
                .FirstOrDefaultAsync(s => s.IdSucursal == id);

            if (sucursal is null)
            {
                error = "La sucursal ya no existe.";
                await CargarSucursales();
                return;
            }

            formulario = new FormularioSucursal
            {
                Nombre = sucursal.Nombre,
                Direccion = sucursal.Direccion,
                Telefono = sucursal.Telefono,
                Activa = sucursal.Activa
            };

            idSucursalEdicion = id;
            esEdicion = true;
            mostrandoFormulario = true;
        }
        catch (Exception)
        {
            error = "No se pudo cargar la sucursal para editar.";
        }
    }

    private async Task GuardarSucursal()
    {
        if (guardando)
            return;

        guardando = true;
        error = null;
        mensaje = null;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            if (esEdicion && idSucursalEdicion.HasValue)
            {
                var sucursal = await db.Sucursal
                    .FirstOrDefaultAsync(s => s.IdSucursal == idSucursalEdicion.Value);

                if (sucursal is null)
                {
                    error = "La sucursal que intentas editar ya no existe.";
                    return;
                }

                sucursal.Nombre = formulario.Nombre.Trim();
                sucursal.Direccion = LimpiarTexto(formulario.Direccion);
                sucursal.Telefono = LimpiarTexto(formulario.Telefono);
                sucursal.Activa = formulario.Activa;

                await db.SaveChangesAsync();
                mensaje = "Sucursal actualizada correctamente.";
            }
            else
            {
                var sucursal = new Sucursal
                {
                    Nombre = formulario.Nombre.Trim(),
                    Direccion = LimpiarTexto(formulario.Direccion),
                    Telefono = LimpiarTexto(formulario.Telefono),
                    Activa = formulario.Activa
                };

                db.Sucursal.Add(sucursal);
                await db.SaveChangesAsync();
                mensaje = "Sucursal creada correctamente.";
            }

            mostrandoFormulario = false;
            await CargarSucursales();
        }
        catch (DbUpdateException)
        {
            error = "No se pudo guardar la sucursal. Verifica los datos y las restricciones de la base de datos.";
        }
        catch (Exception)
        {
            error = "Ocurrió un error al guardar la sucursal.";
        }
        finally
        {
            guardando = false;
        }
    }

    private async Task CambiarEstado(int id)
    {
        if (guardando)
            return;

        guardando = true;
        error = null;
        mensaje = null;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            var sucursal = await db.Sucursal
                .FirstOrDefaultAsync(s => s.IdSucursal == id);

            if (sucursal is null)
            {
                error = "La sucursal ya no existe.";
                return;
            }

            sucursal.Activa = !sucursal.Activa;
            await db.SaveChangesAsync();

            mensaje = sucursal.Activa
                ? "Sucursal activada correctamente."
                : "Sucursal desactivada correctamente.";

            await CargarSucursales();
        }
        catch (DbUpdateException)
        {
            error = "No se pudo cambiar el estado de la sucursal.";
        }
        catch (Exception)
        {
            error = "Ocurrió un error al cambiar el estado.";
        }
        finally
        {
            guardando = false;
        }
    }

    private void CancelarFormulario()
    {
        mostrandoFormulario = false;
        formulario = new FormularioSucursal();
        idSucursalEdicion = null;
        esEdicion = false;
    }

    private static string? LimpiarTexto(string? texto)
    {
        return string.IsNullOrWhiteSpace(texto) ? null : texto.Trim();
    }

    private sealed class FormularioSucursal
    {
        [Required(ErrorMessage = "El nombre es obligatorio.")]
        [StringLength(80, ErrorMessage = "El nombre no puede superar los 80 caracteres.")]
        public string Nombre { get; set; } = string.Empty;

        [StringLength(200, ErrorMessage = "La dirección no puede superar los 200 caracteres.")]
        public string? Direccion { get; set; }

        [StringLength(20, ErrorMessage = "El teléfono no puede superar los 20 caracteres.")]
        public string? Telefono { get; set; }

        public bool Activa { get; set; } = true;
    }
}
